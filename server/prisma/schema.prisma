generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Language {
  CPP
  JAVA
  PYTHON
}

enum TeamStatus {
  NOT_LOGGED_IN
  ACTIVE
  IDLE
  SUBMITTED
  DISQUALIFIED
  REINSTATED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum RoundStatus {
  LOCKED
  ACTIVE
  ENDED
}

enum Verdict {
  ACCEPTED
  WRONG_ANSWER
  COMPILATION_ERROR
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  QUEUED
  RUNNING
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  disqualificationLogs DisqualificationLog[]
  auditLogs           AuditLog[]

  @@map("admins")
}

model Team {
  id               String      @id @default(uuid())
  name             String      @unique
  teamCode         String      @unique @map("team_code")
  passwordHash     String      @map("password_hash")
  initialPassword  String?     @map("initial_password")
  language         Language?
  languageLockedAt DateTime?   @map("language_locked_at")
  status           TeamStatus  @default(NOT_LOGGED_IN)
  score            Float       @default(0)
  disqualifiedAt   DateTime?   @map("disqualified_at")
  reinstatedAt     DateTime?   @map("reinstated_at")
  activeSessionId  String?     @map("active_session_id")
  createdAt        DateTime    @default(now()) @map("created_at")

  participants         Participant[]
  assignments          Assignment[]
  drafts               Draft[]
  submissions          Submission[]
  violations           Violation[]
  disqualificationLogs DisqualificationLog[]

  @@map("teams")
}

model Participant {
  id        String   @id @default(uuid())
  name      String
  rollNo    String   @unique @map("roll_no")
  email     String?
  phone     String?
  teamId    String   @map("team_id")
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("participants")
}

model Round {
  id              String      @id @default(uuid())
  number          Int         @unique
  name            String
  durationMinutes Int         @map("duration_minutes")
  difficulty      Difficulty
  status          RoundStatus @default(LOCKED)
  startedAt       DateTime?   @map("started_at")
  endsAt          DateTime?   @map("ends_at")

  questions Question[]

  @@map("rounds")
}

model Question {
  id                String     @id @default(uuid())
  roundId           String     @map("round_id")
  round             Round      @relation(fields: [roundId], references: [id])
  language          Language
  title             String
  statement         String     @db.Text
  buggyCode         String     @db.Text @map("buggy_code")
  referenceSolution String     @db.Text @map("reference_solution")
  points            Float
  timeLimitMs       Int        @default(5000) @map("time_limit_ms")
  memoryLimitMb     Int        @default(256) @map("memory_limit_mb")
  isTiebreaker      Boolean    @default(false) @map("is_tiebreaker")
  createdAt         DateTime   @default(now()) @map("created_at")

  testCases   TestCase[]
  assignments Assignment[]
  drafts      Draft[]
  submissions Submission[]

  @@map("questions")
}

model TestCase {
  id             String   @id @default(uuid())
  questionId     String   @map("question_id")
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  stdin          String   @db.Text
  expectedStdout String   @db.Text @map("expected_stdout")
  isHidden       Boolean  @default(false) @map("is_hidden")
  weight         Float    @default(1.0)

  @@map("test_cases")
}

model Assignment {
  id         String   @id @default(uuid())
  teamId     String   @map("team_id")
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  questionId String   @map("question_id")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@unique([teamId, questionId])
  @@map("assignments")
}

model Draft {
  id         String   @id @default(uuid())
  teamId     String   @map("team_id")
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  questionId String   @map("question_id")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  code       String   @db.Text
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([teamId, questionId])
  @@map("drafts")
}

model Submission {
  id            String     @id @default(uuid())
  teamId        String     @map("team_id")
  team          Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  questionId    String     @map("question_id")
  question      Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  code          String     @db.Text
  language      Language
  verdict       Verdict
  testsPassed   Int        @map("tests_passed")
  testsTotal    Int        @map("tests_total")
  pointsAwarded Float      @map("points_awarded")
  execTimeMs    Int?       @map("exec_time_ms")
  submittedAt   DateTime   @default(now()) @map("submitted_at")

  @@map("submissions")
}

model Violation {
  id         String   @id @default(uuid())
  teamId     String   @map("team_id")
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  type       String
  details    String?  @db.Text
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@map("violations")
}

model DisqualificationLog {
  id                    String   @id @default(uuid())
  teamId                String   @map("team_id")
  team                  Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  action                String   // 'DISQUALIFY' or 'REINSTATE'
  reason                String   @db.Text
  adminId               String   @map("admin_id")
  admin                 Admin    @relation(fields: [adminId], references: [id])
  remainingTimeSnapshot Int?     @map("remaining_time_snapshot")
  createdAt             DateTime @default(now()) @map("created_at")

  @@map("disqualification_logs")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorType String   @map("actor_type") // 'ADMIN' or 'SYSTEM'
  actorId   String?  @map("actor_id")
  admin     Admin?   @relation(fields: [actorId], references: [id])
  action    String
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model EventSettings {
  id                      String    @id @default(uuid())
  eventStatus             String    @default("NOT_STARTED") @map("event_status")
  eventStartedAt          DateTime? @map("event_started_at")
  eventPausedAt           DateTime? @map("event_paused_at")
  totalPausedDurationSecs Int       @default(0) @map("total_paused_duration_secs")

  tabSwitchEnabled        Boolean   @default(true) @map("tab_switch_enabled")
  tabSwitchThreshold      Int       @default(3) @map("tab_switch_threshold")
  fullscreenExitEnabled   Boolean   @default(true) @map("fullscreen_exit_enabled")
  fullscreenExitThreshold Int       @default(3) @map("fullscreen_exit_threshold")
  tabCloseEnabled         Boolean   @default(true) @map("tab_close_enabled")
  tabCloseThreshold       Int       @default(1) @map("tab_close_threshold")
  disconnectGraceSecs     Int       @default(60) @map("disconnect_grace_secs")
  dualLoginEnabled        Boolean   @default(true) @map("dual_login_enabled")

  scoringMode             String    @default("PARTIAL") @map("scoring_mode") // 'PARTIAL' or 'ALL_OR_NOTHING'
  maxSubmissionsPerQuestion Int?    @map("max_submissions_per_question")
  runRateLimitSecs        Int       @default(5) @map("run_rate_limit_secs")

  @@map("event_settings")
}
